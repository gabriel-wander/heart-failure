      "referenceIds": ["greene2023"]
    },
    {
      "id": "add_vericiguat",
      "classId": "vericiguat",
      "logic": "all",
      "status": "eligible",
      "title": "Vericiguate",
      "conditions": [{ "field": "lvef", "op": "lte", "value": 40 }],
      "justification": "Considerar vericiguate em piora recente da IC apesar de GDMT (ex.: hospitalização ou necessidade de diurético IV).",
      "safetyAlertIds": [],
      "referenceIds": ["greene2023"]
    },
    {
      "id": "add_digoxin",
      "classId": "digoxin",
      "logic": "all",
      "status": "eligible",
      "title": "Digoxina",
      "conditions": [{ "field": "lvef", "op": "lte", "value": 40 }],
      "justification": "Considerar digoxina para alívio sintomático apesar de GDMT, ou como adjuvante no controle de frequência na fibrilação atrial. Vigiar função renal, potássio e toxicidade.",
      "safetyAlertIds": [],
      "referenceIds": ["patolia2023"]
    },
    {
      "id": "add_iv_iron",
      "classId": "iv_iron",
      "logic": "all",
      "status": "eligible",
      "title": "Ferro intravenoso (avaliação)",
      "conditions": [{ "field": "lvef", "op": "lte", "value": 40 }],
      "justification": "Avaliar deficiência de ferro (ferritina e índice de saturação de transferrina); considerar reposição de ferro IV se confirmada, em ICFEr sintomática.",
      "safetyAlertIds": [],
      "referenceIds": ["greene2023"]
    }
