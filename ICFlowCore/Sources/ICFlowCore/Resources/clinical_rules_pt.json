      "status": "caution",
      "conditions": [{ "field": "systolicBP", "op": "lt", "value": 90 }],
      "justification": "PAS < 90 mmHg: cautela ao iniciar/uptitular betabloqueador.",
      "safetyAlertIds": ["bb_decompensation"],
