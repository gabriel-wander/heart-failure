      "safetyAlertIds": ["ras_hyperkalemia"],
      "referenceIds": ["patolia2023"]
    },
    {
      "id": "ras_caution_renal",
      "classId": "renin_angiotensin",
      "logic": "all",
      "status": "caution",
      "conditions": [{ "field": "egfr", "op": "lt", "value": 30 }],
