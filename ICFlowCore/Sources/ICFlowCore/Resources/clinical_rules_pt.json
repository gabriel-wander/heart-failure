      "logic": "all",
      "status": "contraindicated",
      "conditions": [{ "field": "systolicBP", "op": "lt", "value": 90 }],
      "justification": "Hipotensão (PAS < 90 mmHg): não iniciar/uptitular bloqueio do SRAA até estabilização hemodinâmica.",
      "safetyAlertIds": ["ras_hypotension"],
      "referenceIds": ["greene2023"]
    },
    {
      "id": "ras_caution_lowbp",
      "classId": "renin_angiotensin",
      "logic": "all",
      "status": "caution",
      "conditions": [{ "field": "systolicBP", "op": "lt", "value": 100 }],
      "justification": "PAS limítrofe (< 100 mmHg): iniciar em dose reduzida (ex.: INRA 24/26 mg 2×/dia) e monitorar a PA.",
      "safetyAlertIds": ["ras_hypotension"],
      "referenceIds": ["greene2023"]
    },
    {
      "id": "ras_contra_hyperkalemia",
      "classId": "renin_angiotensin",
      "logic": "all",
      "status": "contraindicated",
      "conditions": [{ "field": "potassium", "op": "gt", "value": 5.5 }],
