      "referenceIds": ["felker2020"]
    },
    {
      "id": "acute_rf_hyperkalemia",
      "logic": "all",
      "conditions": [{ "field": "potassium", "op": "gt", "value": 6.0 }],
      "justification": "Potássio > 6,0 mmol/L: hipercalemia grave — manejo imediato.",
      "safetyAlertIds": ["acute_hyperkalemia"],
      "referenceIds": ["felker2020"]
    },
    {
      "id": "acute_rf_renal",
      "logic": "all",
      "conditions": [{ "field": "egfr", "op": "lt", "value": 30 }],
      "justification": "TFGe < 30 mL/min/1,73 m²: maior risco de resistência diurética e deterioração renal — monitorar de perto.",
