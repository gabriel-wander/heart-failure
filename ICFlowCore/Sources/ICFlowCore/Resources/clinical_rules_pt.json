      "referenceIds": ["felker2020"]
    },
    {
      "id": "acute_rf_hypoperfusion",
      "logic": "all",
      "conditions": [{ "field": "hypoperfusion", "op": "isTrue" }],
      "justification": "Sinais de hipoperfusão: avaliar baixo débito; diurético isolado pode ser insuficiente ou deletério.",
